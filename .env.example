# Slop Detector Environment Variables

# AI Provider API Keys (Optional - for AI Consensus Analysis)
# Uncomment and add your API keys to enable AI consensus features

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic API Key  
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Note: The mock provider is always available for testing without API keys

# --- Screenshot vision endpoint (paid, rate-limited, access-controlled) ---
# Required for /api/screenshot: comma-separated "user:token" pairs. Tokens must
# be at least 24 characters. Tokens are hashed in memory with SHA-256 and
# compared in constant time. Rotate by replacing the file and restarting.
# SCREENSHOT_ACCESS_TOKENS=alice:<generate-a-random-token>

# Hard daily spend cap for the screenshot endpoint, in USD. The per-request
# cost is reserved before the provider is called and never refunded.
# SCREENSHOT_DAILY_SPEND_CAP_USD=5.00

# Per-user rate limit (requests per hour). Default 10 when unset.
# SCREENSHOT_RATE_LIMIT_PER_HOUR=10

# Estimated provider cost per vision request, USD, used for the spend cap.
# Default 0.01 when unset. Raise this if you switch to a pricier model.
# SCREENSHOT_ESTIMATED_COST_USD=0.01
